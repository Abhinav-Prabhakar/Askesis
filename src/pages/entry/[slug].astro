---
import Base from "../../layouts/Base.astro";
import ToolBar from "../../components/ToolBar.astro";
import { ENTRIES, ORDER, entryBySlug, tradSlug, FIGCAP, ERAS } from "../../data/library.js";
import { heroSVG, figureSVG } from "../../lib/svg.js";
import { glossify } from "../../lib/glossify.js";
import { u } from "../../lib/url.js";

export function getStaticPaths() {
  return ENTRIES.map(e => ({ params: { slug: e.slug }, props: { entry: e } }));
}
const { entry: e } = Astro.props;
const idx = ORDER.indexOf(e.slug);
const prev = idx > 0 ? entryBySlug[ORDER[idx - 1]] : null;
const next = idx < ORDER.length - 1 ? entryBySlug[ORDER[idx + 1]] : null;
const rel = e.related.map((s: string) => entryBySlug[s]).filter(Boolean).slice(0, 3);
const tslug = tradSlug(e.tradition);
const entryData = JSON.stringify({ slug: e.slug, cite: e.cite });
---
<Base title={`${e.title} — Askēsis`} description={e.hook} view="doc" slug={e.slug}>
  <article class="view is-active" id="view-doc" aria-live="off">
    <ToolBar backTo={u("")} backLabel="EXPLORE" nowTitle={e.title} />
    <nav class="crumbs" aria-label="Breadcrumb">
      {tslug
        ? <a class="crumb p" href={u(`tradition/${tslug}/`)}>{e.tradition.toUpperCase()}</a>
        : <span class="crumb p">{e.tradition.toUpperCase()}</span>}
      <span class="crumb">{e.era.toUpperCase()}</span>
      <span class="readtime">{e.read} MIN READ</span>
    </nav>
    <h1 class="doc-title">{e.title}</h1>
    <p class="doc-hook">{e.hook}</p>
    <div class="hero rv">
      <div class={`hero-art ${e.hero.bg}`} set:html={heroSVG(e.slug)}></div>
      <span class="stamp">{e.read} MIN · EDITED</span>
      <div class="hero-cap"><span class="k">{e.hero.k}</span><span class="big">{e.hero.big}</span><span class="s">{e.hero.sub}</span></div>
    </div>
    <div class="breath rv"><div class="breath-main"><div class="k">IN ONE BREATH</div><p set:html={glossify(e.breath)}></p></div>
      <aside class="breath-file" aria-label="Filed under"><span class="f-n">Nº {String(e.num).padStart(2, "0")}</span><span>{e.tradition.toUpperCase()}</span><span>{e.era.toUpperCase()}</span><span>{e.read} MIN READ</span></aside>
    </div>
    <nav class="era-ribbon rv" aria-label="Where this entry sits in history">
      <span class="era-k">WHERE THIS SITS</span>
      {ERAS.map((er: any) => (
        <span class={er.name === e.era.toUpperCase() ? "era now" : "era"}><b>{er.name}</b><small>{er.span}</small>{er.name === e.era.toUpperCase() && <i>◉ THIS ENTRY</i>}</span>
      ))}
    </nav>
    <nav class="toc rv" aria-label="In this entry">
      <span class="toc-k">IN THIS ENTRY · FIVE STOPS</span>
      <a href="#sec-tension"><b>01</b> THE TENSION</a>
      <a href="#sec-positions"><b>02</b> THREE POSITIONS</a>
      <a href="#sec-argument"><b>03</b> THE ARGUMENT</a>
      <a href="#sec-objection"><b>04</b> OBJECTION VS REPLY</a>
      <a href="#sec-quote"><b>05</b> THE QUOTE</a>
    </nav>
    <div class="doc-sec rv" id="sec-tension"><h2>The tension</h2>{e.tension.map((p: string) => <p set:html={glossify(p)}></p>)}
      {e.positions.length === 3 && (
        <div class="tug" role="img" aria-label={`The pull: ${e.positions[0].name} versus ${e.positions[2].name}`}>
          <span class="tug-k">THE PULL · NEITHER SIDE GIVES</span>
          <div class="tug-row">
            <div class="tug-side"><b>{e.positions[0].name.toUpperCase()}</b><small>{e.positions[0].tag}</small></div>
            <div class="tug-rope" aria-hidden="true"><span class="handle"></span><span class="line"></span><span class="knot"></span><span class="line"></span><span class="handle"></span></div>
            <div class="tug-side r"><b>{e.positions[2].name.toUpperCase()}</b><small>{e.positions[2].tag}</small></div>
          </div>
        </div>
      )}
    </div>
    <div class="doc-sec rv" id="sec-positions"><h2>Three positions</h2>
      <div class="tape" role="list" aria-label="Tale of the tape">
        {e.positions.map((p: any) => (
          <div class="tape-cell" role="listitem"><span class="t-avatar" aria-hidden="true">{p.who}</span><span class="t-name">{p.name.toUpperCase()}</span><span class="t-tag">{p.tag}</span></div>
        ))}
      </div>
      <div class="positions">{e.positions.map((p: any, i: number) => (
        <div class="position"><div class="avatar" aria-hidden="true">{p.who}</div><div class="p-n">0{i + 1}</div><div class="p-t">{p.name.toUpperCase()}</div><p set:html={glossify(p.text)}></p></div>
      ))}</div>
    </div>
    <figure class="fig rv">
      <div class={`fig-art ${e.hero.bg === "cream" ? "" : e.hero.bg}`} set:html={figureSVG(e.slug)}></div>
      <figcaption><b>FIG. {e.num} — </b>{FIGCAP[e.slug] || ""}</figcaption>
    </figure>
    <div class="arg rv" id="sec-argument">
      <div class="arg-h"><b>THE ARGUMENT, IN THREE LINES</b><button type="button" id="copyArg">COPY</button></div>
      <div class="arg-r"><span class="tag">P1</span><span set:html={glossify(e.argument.p1)}></span></div>
      <div class="arg-r"><span class="tag">P2</span><span set:html={glossify(e.argument.p2)}></span></div>
      <div class="arg-r qed"><span class="tag">∴</span><span set:html={glossify(e.argument.c)}></span></div>
    </div>
    <div class="doc-sec rv" id="sec-objection"><h2>The strongest objection</h2>
      <div class="duel">
        <div class="duel-card ob"><span class="duel-k">OBJECTION</span><p set:html={glossify(e.objection)}></p></div>
        <span class="vs" aria-hidden="true">VS</span>
        <div class="duel-card re"><span class="duel-k">REPLY</span><p set:html={glossify(e.reply)}></p></div>
      </div>
    </div>
    <div class="quote rv" id="sec-quote">
      <blockquote>“{e.quote.text.replace(/^“?|”$/g, "")}”</blockquote>
      <cite>{e.quote.by}</cite>
      <div class="q-actions">
        <button class="mini-btn" type="button" id="copyQ">COPY QUOTE</button>
        <button class="mini-btn dark" type="button" id="shareQ">SHARE →</button>
      </div>
    </div>
    <div class="readnext rv"><h2>Read next</h2>
      <div class="rel-grid">{rel.map((r: any) => (
        <a href={u(`entry/${r.slug}/`)}><span class="call">CALL Nº {String(r.num).padStart(2, "0")}</span><b>{r.title.toUpperCase()}</b><small>{r.read} MIN · {r.tradition.toUpperCase()}</small></a>
      ))}</div>
    </div>
    <div class="prevnext rv">
      {prev
        ? <a href={u(`entry/${prev.slug}/`)}><small>← PREV</small><b>{prev.title.toUpperCase()}</b></a>
        : <a href={u("")}><small>←</small><b>BACK TO EXPLORE</b></a>}
      {next
        ? <a href={u(`entry/${next.slug}/`)}><small>NEXT →</small><b>{next.title.toUpperCase()}</b></a>
        : <a href={u("start-here/")}><small>NEXT →</small><b>START HERE PATH</b></a>}
    </div>
    <div class="extras rv">
      <div class="cite">
        <h3>Cite this entry</h3>
        <div class="cite-tabs" role="group" aria-label="Citation style">
          <button type="button" data-c="apa" class="on">APA</button><button type="button" data-c="mla">MLA</button><button type="button" data-c="bib">BibTeX</button>
        </div>
        <pre id="citeOut">{e.cite.apa}</pre>
        <button class="mini-btn" type="button" id="copyCite">COPY CITATION</button>
      </div>
      <div class="notes">
        <h3>Your note <small style="font-family:var(--ui);font-size:12px;color:var(--mut)">· SAVED ON THIS DEVICE</small></h3>
        <textarea id="noteBox" aria-label="Your private note" placeholder="One line you'll actually remember…"></textarea>
        <small id="noteMsg">Private. Never leaves this browser.</small>
      </div>
    </div>
    <footer class="colophon rv" aria-label="Colophon"><span>SET IN BEBAS NEUE &amp; HELVETICA</span><span>PRINTED ON CREAM</span><span>ENTRY Nº {String(e.num).padStart(2, "0")} OF {ORDER.length}</span></footer>
  </article>
  <script type="application/json" id="entryData" is:inline set:html={entryData}></script>
</Base>
