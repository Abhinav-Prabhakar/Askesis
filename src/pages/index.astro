---
import Base from "../layouts/Base.astro";
import { ENTRIES, THINKERS, TRADITIONS, EXPERIMENTS, SERIES, SOON, ERAS, DAILY, FEATURED, ORDER, azMap } from "../data/library.js";
import { heroSVG, expArt, seriesArt, thinkerPortrait, crestArt, eraArt } from "../lib/svg.js";
import { u } from "../lib/url.js";

const base = import.meta.env.BASE_URL;
const az = azMap();
const AZ_LETTERS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");
const AZ_BOOKS = AZ_LETTERS.map((L, i) => ({ L, n: (az[L] || []).length, i }));
const AZ_TOTAL = AZ_BOOKS.reduce((n, b) => n + b.n, 0);
const tierSum = (books: typeof AZ_BOOKS) => books.reduce((n, b) => n + b.n, 0);
const strip = (s: string) => s.replace(/^#\/+/, "");
const latestSlug = ENTRIES[ENTRIES.length - 1].slug;

const homeData = {
  daily: DAILY.map(d => ({ q: d.q, to: strip(d.to) })),
  featured: FEATURED.map(f => ({ text: f.text, sub: f.sub, to: strip(f.to) })),
  az,
  recentMap: Object.fromEntries(ENTRIES.map(e => [e.slug, { slug: e.slug, title: e.title, read: e.read, tradition: e.tradition }]))
};
const stats = `<b>${ENTRIES.length} SHELVES</b> · ${THINKERS.length} THINKERS · ${TRADITIONS.length} SCHOOLS · ${EXPERIMENTS.length} PUZZLES · ${SERIES.length} SERIES`;
/* seeded spine heights + colours so the open shelf looks uneven like a real one */
const BOOK_JITTER = [10, 0, 16, 6, 2, 14, 8, 12, 4, 16, 8, 2, 13, 6, 10, 0, 16, 8, 12, 3, 14, 6, 10, 2, 16, 8];
const BOOK_TILT = [0, 0, -2, 0, 0, 2, 0, 0, -2, 0, 0, 2, 0, 0, 0, -2, 0, 0, 2, 0, 0, -2, 0, 0, 2, 0];
const SPINES = ["#feabe3", "#d8aafe", "#fff8f4", "#fbd7d7", "#d8aafe", "#feabe3", "#fbd7d7", "#feabe3", "#d8aafe", "#fbd7d7", "#fff8f4", "#d8aafe", "#feabe3", "#feabe3", "#d8aafe", "#fbd7d7", "#feabe3", "#fff8f4", "#d8aafe", "#feabe3", "#fbd7d7", "#feabe3", "#d8aafe", "#fff8f4", "#feabe3", "#fbd7d7"];
/* atlas constellations: four fields, each with its own star pattern */
const CONST_POS: number[][][] = [
  [[100, 58]],
  [[100, 54]],
  [[34, 84], [70, 48], [104, 76], [138, 40], [172, 66]],
  [[30, 76], [66, 44], [100, 70], [136, 86], [172, 48]]
];
const SKY_DUST = [
  [[18, 22], [52, 16], [148, 20], [182, 36], [26, 60], [62, 102], [118, 14], [172, 96], [192, 66], [94, 106]],
  [[16, 40], [44, 24], [120, 14], [158, 28], [184, 52], [26, 88], [96, 104], [142, 98], [176, 78], [64, 64]],
  [[20, 30], [48, 18], [104, 98], [146, 16], [178, 30], [188, 74], [32, 74], [68, 102], [122, 104], [160, 88]],
  [[14, 26], [42, 14], [88, 20], [130, 12], [186, 42], [22, 66], [54, 94], [110, 104], [150, 96], [194, 72]]
];
const ERA_ROMAN = ["I", "II", "III", "IV"];
const pad2 = (n: number) => String(n).padStart(2, "0");
---
<Base title="Askēsis — Philosophy, Reframed" description="A pocket library of philosophy. Short entries, argument cards, thought experiments and 60-second series — edited, not encyclopedic." view="explore">
  <div class="view is-active" id="view-explore">
    <div class="panel-top">
      <h2 class="explore-title" id="exploreTitle">EXPLORE</h2>
      <button class="surprise" id="surpriseBtn" type="button">
        <svg class="dice" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="1.4" y="1.4" width="21.2" height="21.2" rx="5.2" stroke="currentColor" stroke-width="2.1"/>
          <circle cx="7.2" cy="7.2" r="1.85" fill="currentColor"/>
          <circle cx="16.8" cy="7.2" r="1.85" fill="currentColor"/>
          <circle cx="12" cy="12" r="1.85" fill="currentColor"/>
          <circle cx="7.2" cy="16.8" r="1.85" fill="currentColor"/>
          <circle cx="16.8" cy="16.8" r="1.85" fill="currentColor"/>
        </svg>
        <span>Surprise me</span>
      </button>
    </div>

    <button class="daily rv" id="dailyBtn" type="button">
      <span class="daily-kicker" id="dailyKicker">TODAY'S QUESTION</span>
      <span class="daily-q" id="dailyQ">Are you lying to yourself right now?</span>
      <span class="daily-go" aria-hidden="true">→</span>
    </button>

    <div class="stats rv" id="statsRow" set:html={stats}></div>

    <nav class="topics" aria-label="Entries" id="topicGrid">
      {ENTRIES.map(e => (
        <a class={`topic rv${e.slug === latestSlug ? " latest" : ""}`} href={u(`entry/${e.slug}/`)}>
          {e.slug === latestSlug && <span class="new-stamp" aria-hidden="true">NEW</span>}
          <span class="t-art" aria-hidden="true" set:html={heroSVG(e.slug).replace("<svg ", '<svg preserveAspectRatio="xMidYMid slice" ')}></span>
          <span class="num">{e.num}</span>
          <span class="t"><span class="name">{e.title.toUpperCase()}</span><span class="meta">{e.read} MIN · {e.tradition.toUpperCase()}</span></span>
        </a>
      ))}
    </nav>

    <div class="duo rv">
      <a class="start-card" href={u("start-here/")}>
        <span class="card-kicker">NEW · 5 STEPS</span>
        <span class="card-title">START HERE</span>
        <span class="card-sub">Never read philosophy? Take the 10-minute path.</span>
        <span class="steps" aria-hidden="true"><i>1</i><i>2</i><i>3</i><i>4</i><i>5</i></span>
      </a>
      <button class="featured-mini" id="featuredCard" type="button">
        <span class="card-kicker">WISDOM OF THE WEEK</span>
        <span class="card-quote" id="featuredQuote">“Man is condemned to be free.”</span>
        <span class="card-sub" id="featuredSub">Sartre · Bad Faith — read in 2 min →</span>
      </button>
    </div>

    <h2 class="series-title rv">MINI SCROLL SERIES</h2>
    <p class="section-sub rv">One idea · five cards · 60 seconds. Tap to unroll.</p>
    <div class="series-row" id="seriesRow">
      {SERIES.map((s, i) => (
        <a class="series-card rv" href={u(`series/${s.slug}/`)}>
          <span class="scroll-rod" aria-hidden="true"></span>
          <span class="series-art" aria-hidden="true" set:html={seriesArt(i)}></span>
          <span class="scroll-body">
            <span class="scroll-no">MINI SCROLL Nº {pad2(i + 1)} · 60″</span>
            <span class="s-t">{s.title.toUpperCase()}</span>
            <span class="s-m">{s.meta}</span>
            <span class="seals" aria-hidden="true"><i class="on"></i><i></i><i></i><i></i><i></i></span>
            <span class="scroll-hint">UNROLL →</span>
          </span>
          <span class="scroll-rod" aria-hidden="true"></span>
        </a>
      ))}
    </div>

    <h2 class="series-title rv">THOUGHT EXPERIMENTS</h2>
    <p class="section-sub rv">Short standalone puzzles. Run one in your head.</p>
    <div class="exp-row" id="expRow">
      {EXPERIMENTS.map(e => (
        <a class="exp-card rv" href={u(`experiment/${e.slug}/`)}>
          <span class="exp-art" style={`background:${e.color}`} set:html={expArt(e)}></span>
          <span class="e-t">{e.title.toUpperCase()}</span>
          <span class="e-m">{e.by.toUpperCase()} · {e.read} MIN</span>
        </a>
      ))}
    </div>

    <h2 class="series-title rv">THE ATLAS</h2>
    <p class="section-sub rv">Four eras, charted as constellations. Every star is a door.</p>
    <div class="atlas rv" id="atlasRow">
      <div class="atlas-bar">
        <span class="atlas-k">THE ATLAS · FOUR FIELDS</span>
        <span class="atlas-n">PLATE Nº 03 · {ENTRIES.length} SHELVES</span>
      </div>
      <div class="atlas-grid">
        {ERAS.map((er, ei) => {
          const items = [
            ...ENTRIES.filter(e => e.era.toUpperCase() === er.name).map(e => ({ num: e.num as number | undefined, slug: e.slug, title: e.title, soon: false })),
            ...SOON.filter(s => s.era.toUpperCase() === er.name).map(s => ({ num: undefined as number | undefined, slug: s.slug, title: s.title, soon: true }))
          ];
          const pts = CONST_POS[ei].slice(0, Math.max(1, items.length));
          return (
            <div class="atlas-era">
              <span class="era-art" aria-hidden="true" set:html={eraArt(er.name)}></span>
              <span class="e-rom" aria-hidden="true">{ERA_ROMAN[ei]}</span>
              <div class="e-head">
                <span class="e-name">{er.name}</span>
                <span class="e-span">{er.span}</span>
              </div>
              <div class="e-map">
                <svg class="e-lines" viewBox="0 0 200 120" preserveAspectRatio="none" aria-hidden="true">
                  {items.length > 1 && <polyline points={pts.map(p => p.join(",")).join(" ")} fill="none" stroke="rgba(250,222,222,.5)" stroke-width="1.5" stroke-dasharray="3 6"/>}
                  {items.length === 1 && <circle cx={pts[0][0]} cy={pts[0][1]} r="30" fill="none" stroke="rgba(250,222,222,.48)" stroke-width="1.5" stroke-dasharray="3 6"/>}
                  {items.length === 1 && <path d={`M${pts[0][0] - 42} ${pts[0][1]} H${pts[0][0] - 35} M${pts[0][0] + 35} ${pts[0][1]} H${pts[0][0] + 42} M${pts[0][0]} ${pts[0][1] - 42} V${pts[0][1] - 35} M${pts[0][0]} ${pts[0][1] + 35} V${pts[0][1] + 42}`} stroke="rgba(250,222,222,.42)" stroke-width="1.5"/>}
                  {SKY_DUST[ei].map(p => <circle cx={p[0]} cy={p[1]} r={ei === 3 ? 1.4 : 1.7} fill="rgba(250,222,222,.5)"/>)}
                </svg>
                {items.length === 0 && <span class="e-empty">UNCHARTED</span>}
                {items.map((it, j) => it.soon
                  ? <a class="dot soon" href={u(`soon/${it.slug}/`)} style={`--x:${(pts[j][0] / 200) * 100}%;--y:${(pts[j][1] / 120) * 100}%`} title={`${it.title} — being written`} aria-label={`${it.title} — being written`}>✎</a>
                  : <a class="dot" href={u(`entry/${it.slug}/`)} style={`--x:${(pts[j][0] / 200) * 100}%;--y:${(pts[j][1] / 120) * 100}%`} title={it.title} aria-label={`${it.title} — shelf ${it.num}`}>{it.num}</a>)}
              </div>
              <div class="e-foot">
                <span>{items.length} {items.length === 1 ? "SHELF" : "SHELVES"}</span>
                <span class="e-coord">Nº {pad2(ei + 1)} / 04</span>
              </div>
            </div>
          );
        })}
      </div>
      <div class="atlas-foot">
        <span class="ap-key"><i class="ap-dot"></i> PUBLISHED</span>
        <span class="ap-key"><i class="ap-dot soon"></i> BEING WRITTEN</span>
        <span class="ap-compass" aria-hidden="true">
          <svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="15" fill="none" stroke="#fadede" stroke-width="1.6"/><path d="M20 4 L24 20 L20 36 L16 20 Z" fill="#feabe3" stroke="#0a0505" stroke-width="2"/><text x="20" y="10" text-anchor="middle" font-family="Bebas Neue, Arial Narrow, sans-serif" font-size="8" fill="#fadede">N</text></svg>
          OLDEST FIRST
        </span>
      </div>
    </div>

    <h2 class="series-title rv">THE SCHOOLS</h2>
    <p class="section-sub rv">Six crests, six camps of thought. Pick a banner.</p>
    <div class="schools rv">
      {TRADITIONS.map(t => (
        <a class="crest" href={u(`tradition/${t.slug}/`)}>
          <span class="crest-art" aria-hidden="true" set:html={crestArt(t.slug)}></span>
          <span class="crest-name">{t.name.toUpperCase()}</span>
          <span class="crest-meta">{t.entries.length} {t.entries.length === 1 ? "ENTRY" : "ENTRIES"} · ONE SCHOOL</span>
        </a>
      ))}
    </div>

    <h2 class="series-title rv">THE CAST</h2>
    <p class="section-sub rv">Nine minds, one stage. Every portrait opens an entry.</p>
    <div class="cast-stage rv">
      <svg class="pelmet" viewBox="0 0 1200 36" preserveAspectRatio="none" aria-hidden="true"><path d="M0 0 H1200 V14 L1140 32 L1080 14 L1020 32 L960 14 L900 32 L840 14 L780 32 L720 14 L660 32 L600 14 L540 32 L480 14 L420 32 L360 14 L300 32 L240 14 L180 32 L120 14 L60 32 L0 14 Z" fill="#d1393c" stroke="#060204" stroke-width="4"/></svg>
      <div class="cast">
        {THINKERS.map((t, i) => (
          <a class="cast-card" href={u(`thinker/${t.slug}/`)}>
            <span class="cast-no">Nº {pad2(i + 1)}</span>
            <span class="cast-face" aria-hidden="true" set:html={thinkerPortrait(t.slug)}></span>
            <b>{t.name.toUpperCase()}</b>
            <small>{t.years}<br />{t.school.toUpperCase()}</small>
            <span class="cast-cue">{t.entries.length} {t.entries.length === 1 ? "ENTRY" : "ENTRIES"} <i aria-hidden="true">→</i></span>
          </a>
        ))}
      </div>
      <span class="footlights" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
    </div>

    <h2 class="series-title rv">THE INDEX</h2>
    <p class="section-sub rv">Every shelf, A to Z. Pull a spine to open its catalogue cards.</p>
    <div class="az rv" id="azRow">
      <div class="az-case">
        <div class="az-cornice">
          <span class="az-cornice-k">THE INDEX</span>
          <span class="az-cornice-n">A–Z · 26 SPINES · {AZ_TOTAL} CARDS</span>
        </div>
        {[
          { books: AZ_BOOKS.slice(0, 13), range: "A–M", n: tierSum(AZ_BOOKS.slice(0, 13)) },
          { books: AZ_BOOKS.slice(13), range: "N–Z", n: tierSum(AZ_BOOKS.slice(13)) }
        ].map(t => (
          <div class="az-tier">
            <div class="az-books">
              <span class="az-bookend l" aria-hidden="true"></span>
              {t.books.map(b => b.n
                ? <button type="button" class="lit book" data-az={b.L} style={`--bh:${Math.round(100 + BOOK_JITTER[b.i])}px;--spine:${SPINES[b.i]};--tilt:${BOOK_TILT[b.i]}deg`} aria-expanded="false" aria-controls="azPanel" aria-label={`${b.L}: ${b.n} shelf${b.n > 1 ? "s" : ""}`}>
                    <span class="b-mark" aria-hidden="true"></span>
                    <span class="b-letter">{b.L}</span>
                    <span class="b-label"><b>{b.n}</b><i>{b.n === 1 ? "SHELF" : "SHELVES"}</i></span>
                    <span class="b-ribbon" aria-hidden="true"></span>
                  </button>
                : <button type="button" class="book is-empty" disabled style={`--bh:${Math.round(76 + BOOK_JITTER[b.i] * 0.7)}px`} aria-label={`${b.L}: no shelves`}>
                    <span class="b-letter">{b.L}</span>
                    <span class="b-label"><b>0</b><i>EMPTY</i></span>
                  </button>)}
              <span class="az-bookend r" aria-hidden="true"></span>
            </div>
            <div class="az-plank">
              <span class="az-plate">{t.range}</span>
              <span class="az-plate-n">{t.n} SHELVES</span>
            </div>
          </div>
        ))}
        <div class="az-base">
          <span>ASKĒSIS · PUBLIC LIBRARY</span>
          <span class="az-base-hint">PULL A LIT SPINE →</span>
          <span>CATALOGUE Nº 06</span>
        </div>
      </div>
      <div class="az-panel" id="azPanel" hidden></div>
    </div>

    <div class="recent rv" id="recentWrap" hidden>
      <h3>RECENTLY VIEWED</h3>
      <div class="recent-row" id="recentRow"></div>
    </div>

    <div class="ticker rv" aria-hidden="true"><div class="ticker-in"><span>STOICISM · EXISTENTIALISM · SKEPTICISM · SCHOLASTICISM · DEONTOLOGY · ABSURDITY · METAPHYSICS · MIND · ETHICS · TIME · FAITH · REASON · FREEDOM · JUSTICE ·&nbsp;</span><span>STOICISM · EXISTENTIALISM · SKEPTICISM · SCHOLASTICISM · DEONTOLOGY · ABSURDITY · METAPHYSICS · MIND · ETHICS · TIME · FAITH · REASON · FREEDOM · JUSTICE ·&nbsp;</span></div></div>

    <footer class="sheet-foot rv">
      <span>ASKĒSIS · EDITED, NOT ENCYCLOPEDIC</span>
      <span class="foot-links"><a href={u("start-here/")}>Start here</a> · <a href={u("feed.xml")}>RSS</a> · <a href={u("entry/sartre-bad-faith/")}>Sample entry</a></span>
      <span class="seal" aria-hidden="true">Æ</span>
    </footer>
  </div>

  <script type="application/json" id="homeData" is:inline set:html={JSON.stringify(homeData)}></script>
</Base>
