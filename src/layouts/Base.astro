---
import "../styles/styles.css";
import fontLatin from "../assets/fonts/bebas-neue-latin.woff2?url";
import fontLatinExt from "../assets/fonts/bebas-neue-latin-ext.woff2?url";
import favicon from "../assets/favicon.svg?url";
import ogImage from "../assets/og.png?url";
import { buildSearchIndex, GLOSS } from "../data/library.js";
import { u } from "../lib/url.js";

interface Props {
  title: string;
  description: string;
  view?: "explore" | "doc";
  slug?: string;
}
const { title, description, view = "explore", slug } = Astro.props;
const base = import.meta.env.BASE_URL;
const ogAbs = new URL(ogImage, Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const searchIndexJson = JSON.stringify(buildSearchIndex());
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content="website">
<meta property="og:image" content={ogAbs}>
<meta property="og:url" content={canonical}>
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href={favicon} type="image/svg+xml">
<link rel="manifest" href={u("manifest.webmanifest")}>
<meta name="theme-color" content="#d1393c">
<link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={fontLatinExt} as="font" type="font/woff2" crossorigin>
<script is:inline>document.documentElement.classList.add('js')</script>
</head>
<body data-view={view} data-base={base} data-slug={slug}>
<a class="skip" href="#sheetScroll">Skip to reading sheet</a>

<div class="viewport">
<main class="stage" id="stage" aria-label="Askēsis philosophy library">

<div class="scene" aria-hidden="true">
  <div class="topline"></div>
  <div class="bg-card warm top-row" style="--x:-49px;  --y:52px;  --w:292px; --h:168px"><span>STOICISM</span></div>
  <div class="bg-card warm top-row" style="--x:264px;  --y:52px;  --w:292px; --h:168px"><span style="--nudge:1px">PLATONISM</span></div>
  <div class="bg-card top-row" style="--x:1098px; --y:52px;  --w:292px; --h:168px"><span style="--nudge:-1px">ARISTOTLE</span></div>
  <div class="bg-card top-row" style="--x:1412px; --y:52px;  --w:381px; --h:168px"><span>PLATONISM</span></div>
  <div class="bg-card" style="--x:-184px; --y:247px; --w:292px; --h:168px"><span style="--nudge:2px">THEISM</span></div>
  <div class="bg-card" style="--x:130px;  --y:247px; --w:292px; --h:168px"><span>EPICURUS</span></div>
  <div class="bg-card" style="--x:444px;  --y:247px; --w:292px; --h:168px"><span>AUGUSTINE</span></div>
  <div class="bg-card" style="--x:759px;  --y:247px; --w:292px; --h:168px"><span>HOBBES</span></div>
  <div class="bg-card" style="--x:1073px; --y:247px; --w:292px; --h:168px"><span>KANT</span></div>
  <div class="bg-card" style="--x:1388px; --y:247px; --w:280px; --h:168px"><span style="--nudge:-2px">DESCARTES</span></div>
  <div class="bg-card" style="--x:12px;   --y:441px; --w:261px; --h:168px"><span style="--nudge:-2px">SKEPTICISM</span></div>
  <div class="bg-card" style="--x:1230px; --y:441px; --w:328px; --h:168px"><span style="--nudge:11px">AGENT</span></div>
  <div class="bg-card" style="--x:1584px; --y:441px; --w:230px; --h:168px"><span>PLOTINUS</span></div>
  <div class="bg-card" style="--x:-107px; --y:636px; --w:300px; --h:168px"><span style="--nudge:1px">ABSURDISM</span></div>
  <div class="bg-card" style="--x:1220px; --y:636px; --w:225px; --h:168px"><span>CAMUS</span></div>
  <div class="bg-card" style="--x:1467px; --y:636px; --w:256px; --h:168px"><span style="--nudge:-1px">NIETZSCHE</span></div>
  <div class="bg-card" style="--x:-100px; --y:830px; --w:148px; --h:168px"><span></span></div>
  <div class="bg-card" style="--x:70px;   --y:830px; --w:234px; --h:168px"><span style="--nudge:-2px">NIHILISM</span></div>
  <div class="bg-card" style="--x:1323px; --y:830px; --w:292px; --h:168px"><span style="--nudge:5px">SPINOZA</span></div>
  <div class="bg-card" style="--x:-60px;  --y:1025px; --w:320px; --h:168px"><span>HERACLITUS</span></div>
  <div class="bg-card" style="--x:330px;  --y:1025px; --w:292px; --h:168px"><span>LOCKE</span></div>
  <div class="bg-card" style="--x:1300px; --y:1025px; --w:300px; --h:168px"><span>WITTGENSTEIN</span></div>
  <header class="masthead">
    <h1>ASKĒSIS</h1>
    <p>PHILOSOPHY, REFRAMED</p>
  </header>
  <div class="grain"></div>
  <div class="rails"></div>
</div>

<button class="search-btn" id="searchBtn" type="button" aria-label="Search (press /)" aria-expanded="false" aria-controls="searchPop">
  <svg width="21" height="21" viewBox="0 0 22 22" fill="none" aria-hidden="true">
    <circle cx="9.4" cy="9.4" r="6.1" stroke="currentColor" stroke-width="2.4"/>
    <path d="M14.1 14.1L19 19" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/>
  </svg>
</button>

<section class="explore-panel" id="sheet" aria-label="Reading sheet">
  <div class="progress" id="progress" aria-hidden="true"></div>

  <div class="sheet-scroll" id="sheetScroll" tabindex="-1">

    <slot />

  </div>
</section>

<div class="search-pop" id="searchPop" hidden role="dialog" aria-label="Search">
  <div class="search-field">
    <svg width="18" height="18" viewBox="0 0 22 22" fill="none" aria-hidden="true">
      <circle cx="9.4" cy="9.4" r="6.1" stroke="currentColor" stroke-width="2.4"/>
      <path d="M14.1 14.1L19 19" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/>
    </svg>
    <input id="searchInput" type="search" placeholder="Search the library…" autocomplete="off" spellcheck="false" aria-label="Search">
  </div>
  <div class="chips filters" role="group" aria-label="Filter">
    <button type="button" data-f="all" class="on" aria-pressed="true">All</button>
    <button type="button" data-f="entry" aria-pressed="false">Entries</button>
    <button type="button" data-f="thinker" aria-pressed="false">Thinkers</button>
    <button type="button" data-f="experiment" aria-pressed="false">Puzzles</button>
    <button type="button" data-f="tradition" aria-pressed="false">Schools</button>
  </div>
  <div class="search-results" id="searchResults" role="listbox" aria-live="polite"></div>
</div>

</main>
</div>

<div class="g-tip" id="glossTip" hidden role="definition"></div>
<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script type="application/json" id="searchIndex" is:inline set:html={searchIndexJson}></script>
<script type="application/json" id="glossData" is:inline set:html={JSON.stringify(GLOSS)}></script>
<script src={u("js/app.js")} defer></script>
</body>
</html>
